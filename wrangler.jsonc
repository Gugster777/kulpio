// Kulpio — all-in-one Cloudflare entry point.
//
// One deploy (the connected Workers Build, or `npx wrangler deploy`) serves
// BOTH the app (static assets; non-app files excluded via .assetsignore) and
// the AI/API endpoints on a single URL. The cache wrapper sits in front of
// the AI worker so repeated deterministic requests do not consume AI budget.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kulpio",
  "main": "ai-proxy/cached-worker.js",
  "compatibility_date": "2026-07-02",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kulpio-scans",
      "database_id": "0bb223ac-f2e1-4490-95d7-8f742e15268d"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 7 * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
